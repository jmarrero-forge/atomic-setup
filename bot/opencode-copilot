#!/usr/bin/python3 -I
"""opencode with the GitHub Copilot login from OPENCODE_AUTH_CONTENT, the
podman secret bot/copilot-login.sh stores (opencode 1's auth.json format).

    opencode-copilot OPENCODE-ARGS...
    opencode auth export | opencode-copilot --login-from-export

opencode 2 keeps logins in its database and no longer reads that variable,
so this imports the login there (`opencode auth import`, on a private
server) and then runs opencode. The database must be new: a fresh data
directory (a job container, the coordinator's archived one) or an
OPENCODE_DB of its own. In an existing one an import wouldn't replace the
login it may already have, so that's an error.

--login-from-export turns `opencode auth export`'s Copilot login into that
format, for bot/copilot-login.sh."""
import json
import os
import subprocess
import sys

PROG = "opencode-copilot"
COPILOT = "github-copilot"
# A fixed id: a second import of the same database would be skipped.
CREDENTIAL_ID = "cred_bot_copilot"
# Where an Enterprise login's API is (opencode 1's auth.json kept only the
# first), carried both ways.
METADATA = ("enterpriseUrl", "apiEndpoint")


def database():
    """Where opencode keeps its database (cli/src/database-path.ts)."""
    data = os.path.join(os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share"), "opencode")
    return os.path.join(data, os.environ.get("OPENCODE_DB") or "opencode.db")


def credentials(content):
    """opencode 1's auth.json entry for Copilot as `opencode auth export`
    prints it, which `auth import` reads."""
    try:
        login = json.loads(content)[COPILOT]
        refresh = login["refresh"]
    except (ValueError, KeyError, TypeError):
        raise SystemExit(f"{PROG}: OPENCODE_AUTH_CONTENT holds no {COPILOT} login") from None
    metadata = {key: login[key] for key in METADATA if isinstance(login.get(key), str)}
    value = {"type": "oauth", "methodID": "device", "refresh": refresh, "access": login.get("access") or refresh,
             "expires": login.get("expires") or 0}
    if metadata:
        value["metadata"] = metadata
    return [{"id": CREDENTIAL_ID, "integrationID": COPILOT, "label": "OAuth", "active": True, "value": value}]


def redact(text, login):
    """TEXT without the login's tokens, which an error may quote."""
    for token in {login[0]["value"]["refresh"], login[0]["value"]["access"]}:
        text = text.replace(token, "[token]")
    return text


def login_from_export(exported):
    """The active Copilot login in `opencode auth export`'s output, in
    opencode 1's auth.json format: the inverse of credentials()."""
    try:
        logins = [c for c in json.loads(exported) if c.get("integrationID") == COPILOT
                  and c.get("value", {}).get("type") == "oauth"]
    except (ValueError, AttributeError, TypeError):
        raise SystemExit(f"{PROG}: that isn't opencode auth export's output") from None
    if not logins:
        raise SystemExit(f"{PROG}: there's no {COPILOT} login in it")
    value = max(logins, key=lambda c: c.get("active") is True)["value"]
    if not isinstance(value.get("refresh"), str):
        raise SystemExit(f"{PROG}: its {COPILOT} login has no token")
    login = {"type": "oauth", "refresh": value["refresh"], "access": value.get("access") or value["refresh"],
             "expires": value.get("expires") or 0}
    metadata = value.get("metadata") or {}
    login.update({key: metadata[key] for key in METADATA if isinstance(metadata.get(key), str)})
    return {COPILOT: login}


def main():
    if sys.argv[1:] == ["--login-from-export"]:
        json.dump(login_from_export(sys.stdin.read()), sys.stdout)
        print()
        return
    content = os.environ.get("OPENCODE_AUTH_CONTENT")
    if not content:
        sys.exit(f"{PROG}: no Copilot login (OPENCODE_AUTH_CONTENT)")
    db = database()
    if os.path.lexists(db):
        sys.exit(f"{PROG}: {db} already exists, and opencode wouldn't take the login into it; "
                 f"use a fresh data directory or OPENCODE_DB")
    login = credentials(content)
    imported = subprocess.run(["opencode", "auth", "import", "--standalone"], input=json.dumps(login),
                              text=True, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)
    if imported.returncode != 0 or "Imported 1 credential" not in imported.stderr:
        sys.exit(f"{PROG}: importing the login failed: {redact(imported.stderr.strip(), login)}")
    os.execvp("opencode", ["opencode", *sys.argv[1:]])


if __name__ == "__main__":
    main()
